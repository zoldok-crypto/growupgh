<!DOCTYPE html>
<html lang="en">
<head>
	<title>Additional goods</title>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<meta name="viewport" content="initial-scale=1.0, width=device-width">
	<link rel="stylesheet" type="text/css" href="css/style.css">
	<link rel="shortcut icon" href="img/favicon.ico">
</head>
<body>
	<!-- @import "header.html" -->
	<main class="page-body additional-goods">
		<div class="container">
			<ul class="breadcrumbs-list">
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link">Greenhouses</a></li>
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link">Garden pavilions</a></li>
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link current">Additional goods</a></li>
			</ul>
			<div class="additional-goods__box">
				<aside class="aside">
					<ul class="aside__list">
						<li class="aside__item"><a href="#" class="aside__link current">Galvanaized tape<span class="aside-chevron"></span></a></li>
