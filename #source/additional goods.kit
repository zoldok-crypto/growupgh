						<li class="aside__item"><a href="#" class="aside__link">Hang plants</a></li>
					</ul>
				</aside>
				<div class="additional-goods__wrapper">
					<div class="additional-goods__item">
						<div class="card__img additional-goods__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="additional-goods__info">
							<h3 class="card-item__title additional-goods__title">Item name</h3>
							<div class="card-descr additional-goods__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box additional-goods">
								<a href="#" data-popup-target="contacts" class="card-link">More info</a>
							</div>
						</div>
					</div>
					<div class="additional-goods__item">
						<div class="card__img additional-goods__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="additional-goods__info">
							<h3 class="card-item__title additional-goods__title">Item name</h3>
							<div class="card-descr additional-goods__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box additional-goods">
								<a href="#" class="card-link">More info</a>
							</div>
						</div>
					</div>
					<div class="additional-goods__item">
						<div class="card__img additional-goods__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="additional-goods__info">
							<h3 class="card-item__title additional-goods__title">Item name</h3>
							<div class="card-descr additional-goods__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box additional-goods">
								<a href="#" class="card-link">More info</a>
							</div>
						</div>
					</div>
					<div class="additional-goods__item">
						<div class="card__img additional-goods__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="additional-goods__info">
							<h3 class="card-item__title additional-goods__title">Item name</h3>
							<div class="card-descr additional-goods__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box additional-goods">
								<a href="#" class="card-link">More info</a>
