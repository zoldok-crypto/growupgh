						<div class="contact-head">
							<img src="img/icons/russia-icon.svg" alt="" class="contacts-img">
							<span>Russia:</span>
						</div>
						<div class="contact-body">
							<p>167882, Belarus, Minsk, Yubileynyj 1</p>
							<a href="tel:+3752933039090">+375 (29) 330-390-90</a>
							<a href="mailto:sales@mtzshop.by">sales@mtzshop.by</a>
