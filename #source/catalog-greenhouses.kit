<!DOCTYPE html>
<html lang="en">
<head>
	<title>Catalog greenhouses</title>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<meta name="viewport" content="initial-scale=1.0, width=device-width">
	<link rel="stylesheet" type="text/css" href="css/style.css">
	<link rel="shortcut icon" href="img/favicon.ico">
</head>
<body>
	<!-- @import "header.html" -->
	<main class="page-body catalog-greenhouse">
		<div class="container">	
			<ul class="breadcrumbs-list">
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link current">Greenhouses</a></li>
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link">Garden pavilions</a></li>
				<li class="breadcrumb__item"><a href="#" class="breadcrumb__link">Additional goods</a></li>
			</ul>
			<div class="greenhouses-box">
				<aside class="aside">
					<ul class="aside__list">
						<li class="aside__item"><a href="#" class="aside__link current">20x20<span class="aside-chevron"></span></a></li>
						<li class="aside__item"><a href="#" class="aside__link">40x20</a></li>
						<li class="aside__item"><a href="#" class="aside__link">Wide</a></li>
						<li class="aside__item"><a href="#" class="aside__link">Mini</a></li>
						<li class="aside__item"><a href="#" class="aside__link">Non-archs</a></li>
						<li class="aside__item"><a href="#" class="aside__link">Commercial</a></li>
					</ul>
				</aside>
				<div class="greenhouses-cards__wrapper">
					<div class="greenhouses-card__item">
						<div class="card__img greenhouses-card__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="greenhouses-card__info">
							<h3 class="card-item__title greenhouse-card__title">Item name</h3>
							<div class="greenhouses-card__parameters">
								<div class="greenhouses__parameters-item">Pipe</div>
								<div class="greenhouses__parameters-item value">20x20mm</div>
								<div class="greenhouses__parameters-item">Width</div>
								<div class="greenhouses__parameters-item value">3m</div>
								<div class="greenhouses__parameters-item">Lenght</div>
								<div class="greenhouses__parameters-item value">from 4m</div>
								<div class="greenhouses__parameters-item">Height</div>
								<div class="greenhouses__parameters-item value">2.1m</div>
							</div>
							<div class="card__descr greenhouses-card__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box greenhouses-link__box">
								<a href="#" class="card-link">More info</a>
							</div>
						</div>
					</div>
					<div class="greenhouses-card__item">
						<div class="card__img greenhouses-card__img">
							<img src="img/card-img.jpg" alt="">
						</div>
						<div class="greenhouses-card__info">
							<h3 class="card-item__title greenhouse-card__title">Item name</h3>
							<div class="greenhouses-card__parameters">
								<div class="greenhouses__parameters-item">Pipe</div>
								<div class="greenhouses__parameters-item value">20x20mm</div>
								<div class="greenhouses__parameters-item">Width</div>
								<div class="greenhouses__parameters-item value">3m</div>
								<div class="greenhouses__parameters-item">Lenght</div>
								<div class="greenhouses__parameters-item value">from 4m</div>
								<div class="greenhouses__parameters-item">Height</div>
								<div class="greenhouses__parameters-item value">2.1m</div>
							</div>
							<div class="card__descr greenhouses-card__descr">
								<p>Lorem ipsum dolor si amet</p>
							</div>
							<div class="card-link__box greenhouses-link__box">
								<a href="#" class="card-link">More info</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>	
	</main>
	<!-- @import "footer.html" -->
	<!-- @import "modal-callback.html" -->
	<div class="overlay"></div>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
	<script src="js/main.js"></script>
</body>
</html>